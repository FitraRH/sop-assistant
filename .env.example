# Qdrant: kosong = embedded (folder .qdrant). Server: QDRANT_URL=http://localhost:6333
QDRANT_URL=
# fastembed = model asli (unduh sekali) | hash = offline cepat, semantik lemah
EMBED_BACKEND=fastembed
EMBED_MODEL=intfloat/multilingual-e5-large
# LLM opsional (endpoint kompatibel OpenAI). Kosong = tanpa LLM. Contoh Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
